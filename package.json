{
  "name": "dumb-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen": "node scripts/build-examples-index.mjs && tsx scripts/build-registry.ts && shadcn build registry.json -o public/r",
    "dev": "node scripts/build-examples-index.mjs && next dev",
    "build": "pnpm gen && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/build-examples-index.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry": "tsx scripts/build-registry.ts && shadcn build registry.json -o public/r",
    "avatars": "node scripts/build-avatars.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.32.1",
  "description": "One component system, three visual languages. shadcn-compatible React components in Raw, Halo and Volume.",
  "license": "MIT",
  "author": {
    "name": "Deepak Kumar",
    "url": "https://1619.in"
  },
  "homepage": "https://ui.1619.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/KumarDeepak16/dumb-ui.git"
  },
  "bugs": {
    "url": "https://github.com/KumarDeepak16/dumb-ui/issues"
  },
  "keywords": [
    "react",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "radix-ui",
    "design-system",
    "components",
    "brutalism",
    "3d"
  ],
  "engines": {
    "node": ">=20.9"
  }
}
